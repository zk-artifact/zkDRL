#!/usr/bin/env bash
# Optional local toolchain configuration. Copy to env.sh if your Rust/SP1,
# protoc or libclang installations are not already on PATH.
# build.sh sources env.sh when it exists; env.sh is intentionally gitignored.
#
# export CARGO_HOME="$PWD/.tools/cargo"
# export RUSTUP_HOME="$PWD/.tools/rustup"
# export CARGO_TARGET_DIR="$PWD/.build/target"
# export PATH="$CARGO_HOME/bin:$PATH"
# export PROTOC=/path/to/protoc
# export PROTOC_INCLUDE=/path/to/protoc/include
# export LIBCLANG_PATH=/path/to/libclang
# export CARGO_BUILD_JOBS=16 RAYON_NUM_THREADS=16
# export SP1_CIRCUIT_MODE=release
